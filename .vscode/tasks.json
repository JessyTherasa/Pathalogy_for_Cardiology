{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CardioEvidence: Start Full-Stack Server",
      "type": "shell",
      "command": "python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000 --reload",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "CardioEvidence: Start Frontend Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "CardioEvidence: Run Automated Tests",
      "type": "shell",
      "command": "$env:PYTHONPATH='${workspaceFolder}'; python -m pytest backend/tests -v",
      "problemMatcher": [],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
